# Next.js frontend (Lumina) — build + run.
# Uses the full node image so better-sqlite3's native addon and the Prisma
# engines compile/download cleanly. Not the smallest image, but the most
# reliable to build unattended.
FROM node:20-bookworm

WORKDIR /app

# NOTE: do NOT set NODE_ENV=production here — that makes `npm ci` skip
# devDependencies (tailwindcss, @tailwindcss/postcss, typescript) which
# `next build` needs. The runtime container sets NODE_ENV=production via compose.
ENV NEXT_TELEMETRY_DISABLED=1

# Install dependencies first (better layer caching). All deps incl. dev — the
# build needs them.
COPY package.json package-lock.json ./
RUN npm ci

# Prisma client must be generated before the build compiles server code.
COPY prisma ./prisma
COPY prisma.config.ts ./
RUN npx prisma generate

# App source
COPY tsconfig.json next.config.ts postcss.config.mjs eslint.config.mjs ./
COPY public ./public
COPY src ./src
# tsconfig includes **/*.ts, so `next build` typechecks the test files too, and
# src/lib/ai/skillsSync.test.ts imports the canonical shared/skills.json.
# Without this the image builds fine locally and fails inside Docker.
COPY shared ./shared

RUN npm run build

EXPOSE 3000

# Apply migrations against the mounted SQLite volume, then start the server.
CMD ["sh", "-c", "npx prisma migrate deploy && npm run start"]
